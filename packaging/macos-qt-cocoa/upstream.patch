From b74d6cb3c5e8418602494ae549b60839d88ef858 Mon Sep 17 00:00:00 2001
From: Yuri Barreira <yuri.rbarreira@gmail.com>
Date: Sat, 19 Sep 2026 13:59:52 -0300
Subject: [PATCH] macOS: Don't let native a11y elements delete accessible
 interfaces

QMacAccessibilityElement::invalidate() and dealloc() used to delete the
QAccessibleInterfaces behind table rows, columns and cells. Those
interfaces are owned by QAccessibleCache and by the item view:
QAccessibleTable caches the interfaces of its cells and resolves them
again after model changes and whenever a client asks for the selection.
Deleting them behind the table's back left that cache with dangling
entries, so the next accessibility call could read freed memory, and
when the cache lookup came up empty the selection was silently reported
as empty.

Amend b1ed5f656f064e553b33752f8e87d2f5b9553e38 by not deleting
interfaces when a native element goes away. The accessibility cache
already removes an interface when its QObject is destroyed, and
QAccessibleTable deletes the synthetic cell interfaces it owns, so
native elements can be invalidated and destroyed independently of the
interfaces they represent.

The new tst_qaccessibilitymac test resolves a selected cell, removes a
row, and then asks for the table's selected children: without this
change the query fails with kAXErrorCannotComplete.

Fixes: QTBUG-149612
Pick-to: 6.8
Change-Id: Idb11385af8f52829f6cc0eebacaa63ff09b16638
Reviewed-by: Volker Hilsheimer <volker.hilsheimer@qt.io>
(cherry picked from commit 8148c48deb8e4345bacb797cb75c011df6f797fa)
Reviewed-by: Qt Cherry-pick Bot <cherrypick_bot@qt-project.org>
---
 .../cocoa/qcocoaaccessibilityelement.h        |  1 -
 .../cocoa/qcocoaaccessibilityelement.mm       | 33 ++--------
 .../tst_qaccessibilitymac.mm                  | 62 +++++++++++++++++++
 3 files changed, 66 insertions(+), 30 deletions(-)

diff --git a/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.h b/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.h
index a7fc0bdb1cd6..eb8f841bcda2 100644
--- a/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.h
+++ b/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.h
@@ -19,7 +19,6 @@ QT_DECLARE_NAMESPACED_OBJC_INTERFACE(QMacAccessibilityElement, NSObject <NSAcces
 - (instancetype)initWithId:(QAccessible::Id)anId role:(NSAccessibilityRole)role;
 + (instancetype)elementWithId:(QAccessible::Id)anId;
 + (instancetype)elementWithInterface:(QAccessibleInterface *)iface;
-+ (void)removeElementsFromCache:(NSArray *)array;
 - (void)updateTableModel;
 - (QAccessibleInterface *)qtInterface;
 )
diff --git a/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.mm b/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.mm
index b0a381b49845..ceeb0b18a510 100644
--- a/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.mm
+++ b/src/plugins/platforms/cocoa/qcocoaaccessibilityelement.mm
@@ -216,25 +216,14 @@ + (instancetype)elementWithInterface:(QAccessibleInterface *)iface
     return [self elementWithId:anId];
 }
 
-+ (void)removeElementsFromCache:(NSArray *)array {
-    for (uint i = 0; i < array.count; ++i) {
-        QMacAccessibilityElement *cell = [array objectAtIndex:i];
-        if (cell->axid) { // it's a proper cell, remove from cache
-            QAccessibleCache::instance()->deleteInterface(cell->axid);
-        }
-    }
-}
-
 // called by QAccessibleCache::removeAccessibleElement, which also releases
 - (void)invalidate {
     axid = 0;
     if (rows) {
-        [QMacAccessibilityElement removeElementsFromCache:rows];
         [rows autorelease];
         rows = nil;
     }
     if (columns) {
-        [QMacAccessibilityElement removeElementsFromCache:columns];
         [columns autorelease];
         columns = nil;
     }
@@ -243,27 +232,13 @@ - (void)invalidate {
     NSAccessibilityPostNotification(self, NSAccessibilityUIElementDestroyedNotification);
 }
 
-/*!
-    \internal
-
-    If this element represents a table, then the rows and columns array are both
-    populated with elements representing the rows and columns. If this elements
-    represents a row, then the columns array is populated with elements
-    representing the cells. Not all of those synthesized elements might be in
-    the cache, but those that are need to be removed so that we don't end up
-    with stale representations of children when the higher-level element
-    expires.
-*/
+// The view and accessibility cache own the interfaces. Native element teardown
+// must not delete interfaces that the table still references.
 - (void)dealloc {
-    if (rows) {
-        [QMacAccessibilityElement removeElementsFromCache:rows];
+    if (rows)
         [rows release]; // will also release all entries first
-    }
-    if (columns) {
-        [QMacAccessibilityElement removeElementsFromCache:columns];
+    if (columns)
         [columns release]; // will also release all entries first
-    }
-    QAccessibleCache::instance()->deleteInterface(axid);
     [super dealloc];
 }
 
diff --git a/tests/auto/other/qaccessibilitymac/tst_qaccessibilitymac.mm b/tests/auto/other/qaccessibilitymac/tst_qaccessibilitymac.mm
index c2e832a5b662..ec9019b7b103 100644
--- a/tests/auto/other/qaccessibilitymac/tst_qaccessibilitymac.mm
+++ b/tests/auto/other/qaccessibilitymac/tst_qaccessibilitymac.mm
@@ -448,6 +448,7 @@ void clearChildren()
     void notificationsTest();
     void checkBoxTest();
     void tableViewTest();
+    void tableViewSelectionAfterModelChange();
     void treeViewTest();
     void tabBarTest();
     void windowTest();
@@ -777,6 +778,67 @@ void clearChildren()
     }
 }
 
+void tst_QAccessibilityMac::tableViewSelectionAfterModelChange()
+{
+    QTableWidget *tableWidget = new QTableWidget(3, 1, m_window);
+    const QStringList contents = {"Socrates", "Confucius", "Kant"};
+    for (int i = 0; i < contents.size(); ++i)
+        tableWidget->setItem(i, 0, new QTableWidgetItem(contents.at(i)));
+    m_window->addWidget(tableWidget);
+    QVERIFY(QTest::qWaitForWindowExposed(m_window));
+    QCoreApplication::processEvents();
+
+    tableWidget->selectRow(0);
+
+    TestAXObject *appObject = [TestAXObject getApplicationAXObject];
+    QVERIFY(appObject);
+
+    NSArray *windowList = [appObject windowList];
+    QVERIFY([windowList count] == 1);
+    TestAXObject *window = [[TestAXObject alloc]
+            initWithAXUIElementRef:(AXUIElementRef)windowList[0]];
+    QVERIFY(window.valid);
+
+    AXUIElementRef tableViewRef = [window findDirectChildByRole:kAXTableRole];
+    QVERIFY(tableViewRef != nil);
+    TestAXObject *tableView = [[TestAXObject alloc] initWithAXUIElementRef:tableViewRef];
+
+    NSArray *rowArray = [tableView tableRows];
+    QCOMPARE(rowArray.count, 3u);
+    TestAXObject *row = [[TestAXObject alloc] initWithAXUIElementRef:(AXUIElementRef)rowArray[0]];
+    NSArray *cells = row.childList;
+    QCOMPARE(cells.count, 1u);
+    TestAXObject *cell = [[TestAXObject alloc] initWithAXUIElementRef:(AXUIElementRef)cells[0]];
+    QVERIFY([cell.title isEqualToString:@"Socrates"]);
+
+    // Drain native elements before querying the cached selection.
+    @autoreleasepool {
+        tableWidget->setRowCount(2);
+    }
+    QCoreApplication::processEvents();
+
+    CFTypeRef selectedChildrenValue = nullptr;
+    QCOMPARE(AXUIElementCopyAttributeValue(tableViewRef, kAXSelectedChildrenAttribute,
+                                           &selectedChildrenValue), kAXErrorSuccess);
+    NSArray *selectedChildren = (NSArray *)selectedChildrenValue;
+    QVERIFY(selectedChildren != nil);
+    QCOMPARE(selectedChildren.count, 1u);
+    TestAXObject *selectedCell = [[TestAXObject alloc]
+            initWithAXUIElementRef:(AXUIElementRef)selectedChildren[0]];
+    QVERIFY([selectedCell.title isEqualToString:@"Socrates"]);
+
+    [selectedCell release];
+    [selectedChildren release];
+    [cell release];
+    [cells release];
+    [row release];
+    [rowArray release];
+    [tableView release];
+    [window release];
+    [windowList release];
+    [appObject release];
+}
+
 void tst_QAccessibilityMac::treeViewTest()
 {
     QTreeWidget *tw = new QTreeWidget;
